{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodyos.local/schemas/bodyos-daily-log.schema.json",
  "title": "BodyOS Daily Log Import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "sleep": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hours": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 24
            }
          }
        }
      ]
    },
    "condition": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 10
    },
    "steps": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "meals": {
      "$ref": "#/$defs/meals"
    },
    "alcohol": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "consumed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "workout": {
      "$ref": "#/$defs/workout"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "nutrition_totals": {
      "$ref": "#/$defs/nutrition"
    }
  },
  "$defs": {
    "nutrition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "calories_kcal": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "protein_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fat_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "carbs_g": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "basis": {
          "enum": [
            "per_item",
            "per_package",
            "per_serving",
            "per_100g",
            "per_100ml",
            "total",
            "unknown",
            null
          ]
        }
      }
    },
    "mealItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "quantity_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "nutrition": {
          "$ref": "#/$defs/nutrition"
        }
      }
    },
    "meals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breakfast": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mealItem"
          }
        },
        "lunch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mealItem"
          }
        },
        "dinner": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mealItem"
          }
        },
        "snacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mealItem"
          }
        },
        "drinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mealItem"
          }
        }
      }
    },
    "workoutSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rpe": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "completed": {
          "type": "boolean"
        },
        "set_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sets"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "equipment": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workoutSet"
          }
        }
      }
    },
    "workout": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "program_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "workout_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "exercises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exercise"
          }
        }
      }
    }
  }
}
